<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Authors>acdvorak, reliablehosting, twosense, Sparronator9999</Authors>
    <AssemblyTitle>Named Pipe Wrapper library</AssemblyTitle>
    <Company>Sparronator9999</Company>
    <Copyright>Copyright © Andrew C. Dvorak and Contributors 2013</Copyright>
    <Description>A simple, easy to use, strongly-typed wrapper around .NET named pipes.</Description>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>Named Pipe Wrapper</Product>
    <RepositoryUrl>https://github.com/Sparronator9999/NamedPipeWrapper</RepositoryUrl>
    <TargetFramework>net48</TargetFramework>
    <Title>Named Pipe Wrapper library</Title>
    <VersionPrefix>2.1.0</VersionPrefix>
    <VersionSuffix>release</VersionSuffix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.0" />
  </ItemGroup>
</Project>
